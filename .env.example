# Copy to .env and fill in locally. Never commit the real .env file.
# No values are set here — placeholders only.

TWELVE_DATA_API_KEY=
GEMINI_API_KEY=
FRED_API_KEY=

# Used by nero_core.research_agent ("Adam") and nero_core.eve ("Eve") -- both
# read this exact same key, nothing else.
ANTHROPIC_API_KEY=

# Eve's kill switch (nero_core.eve.config.is_enabled) -- unset/empty/anything
# other than "1"/"true"/"yes"/"on" (case-insensitive) means disabled. Default
# to leaving this blank/False. Never commit this set to a truthy value.
EVE_ENABLED=

# Per-session sub-budget in USD, enforced before every LLM call
# (nero_core.eve.budget_ledger). Defaults to $1.50 if unset. The hard
# $20/UTC-month ceiling is NOT env-configurable on purpose -- see
# budget_ledger.py's own MONTH_CEILING_USD comment.
EVE_SESSION_BUDGET_USD=

# --- Wise Man (website/lib/wiseMan/, website/app/api/wise-man/route.ts) ---
# Site-wide chatbot, Vercel-only (these are set in the Vercel project's own
# Environment Variables, not read anywhere by the Python side).

# Feature flag (website/lib/wiseMan/config.ts, same on/off parsing
# convention as EVE_ENABLED above) -- unset/empty/anything other than
# "1"/"true"/"yes"/"on" means disabled. Defaults to disabled.
WISE_MAN_ENABLED=

# REQUIRED once WISE_MAN_ENABLED is on -- without this, every request 503s
# with the same generic "resting" message as a missing ANTHROPIC_API_KEY
# (website/app/api/wise-man/route.ts:78's `if (!apiKey || !sessionSecret)`
# gate). Any random secret string works -- it's used to HMAC-sign the
# session cookie (website/lib/wiseMan/session.ts), not to authenticate
# against anything external. Generate one with, e.g., `openssl rand -hex 32`.
WISE_MAN_SESSION_SECRET=

# Real atomic store for the spend cap and rate limiter (website/lib/wiseMan/
# budget.ts) -- set by linking an Upstash Redis integration in the Vercel
# dashboard (see docs/investigations/wise_man_implementation_report.md's
# "Concrete Upstash Redis linking steps"), not by hand. Without both of
# these, Wise Man fails closed (503) rather than running with a silently
# ineffective spend cap -- see website/app/api/wise-man/route.ts's
# hasRealCounterStoreConfigured() check. The legacy KV_REST_API_URL /
# KV_REST_API_TOKEN names (from the deprecated @vercel/kv integration) also
# work as a fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional, all have sane defaults if unset (website/lib/wiseMan/config.ts,
# budget.ts, rateLimit.ts) -- override only if the defaults need tuning.
# WISE_MAN_DAILY_CAP_USD=3
# WISE_MAN_MONTHLY_CAP_USD=20
# WISE_MAN_RATE_LIMIT_PER_SESSION_PER_HOUR=30
# WISE_MAN_RATE_LIMIT_PER_IP_PER_HOUR=100
# WISE_MAN_RATE_LIMIT_ATTACHMENT_PER_SESSION_PER_HOUR=8
# WISE_MAN_ALLOWED_ORIGINS=https://project-nero-vatican.vercel.app,http://localhost:3000
