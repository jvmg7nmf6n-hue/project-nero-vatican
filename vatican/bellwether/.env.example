# Copy to .env and adjust. All variables are optional — the engine runs fully
# offline (mock data + heuristic agents) with no configuration at all.

# --- LLM (leave blank to run in heuristic mode, no network calls) ---
BELLWETHER_ANTHROPIC_API_KEY=
BELLWETHER_LLM_MODEL=claude-sonnet-4-6
BELLWETHER_LLM_MAX_TOKENS=1500
BELLWETHER_ENABLE_WEB_SEARCH=true
BELLWETHER_WEB_SEARCH_MAX_USES=5

# --- Data providers: "mock" (offline) or "live" (needs provider wiring) ---
BELLWETHER_DATA_MODE=mock

# --- Engine behaviour ---
BELLWETHER_SEED=42
BELLWETHER_MIN_ACTIONABLE_CONFIDENCE=0.35
BELLWETHER_STORE_PATH=./.bellwether_store.json

# --- API ---
BELLWETHER_API_HOST=0.0.0.0
BELLWETHER_API_PORT=8000
